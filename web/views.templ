package web

import (
	"errors"
	"fmt"
	"io/fs"
	"net/url"
	"slices"
	"strings"
	"time"

	"pg/internal/catalog"
	"pg/internal/conn"
	"pg/internal/dockerpg"
	"pg/internal/history"
	"pg/internal/session"
)

templ Index(services []string, current string, readOnly bool, j jobView, err error) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>pg</title>
			<script src="/static/theme.js"></script>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/app.js" defer></script>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<!-- A desktop window rather than a page: panes meet edge to edge with hairlines,
		     chrome (toolbar, rail, sidebar, tab strip, status bar) sits on base-200 and
		     content (editor, results) on base-100. Only the editor, results and status
		     text can be selected, as in a native app. -->
		<body class="h-screen flex flex-col overflow-hidden bg-base-100 text-[13px] select-none">
			<!-- A read-only service draws a warning line along the top of this: see app.css. -->
			<header id="toolbar" class="flex h-11 shrink-0 items-center gap-1 border-b border-base-content/10 bg-base-200 px-2">
				<form hx-post="/connect" hx-trigger="change" hx-target="#status" class="flex items-center gap-1.5">
					<i data-lucide="server" class="size-4 text-base-content/50" aria-hidden="true"></i>
					<span id="service-picker">
						@serviceSelect(services, current)
					</span>
				</form>
				<nav class="ml-auto flex items-center gap-0.5" aria-label="Server tools">
					<div class="tooltip tooltip-bottom" data-tip="Activity">
						<button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Activity" onclick="showActivity()"><i data-lucide="activity" class="size-4"></i></button>
					</div>
					<div class="tooltip tooltip-bottom" data-tip="Health">
						<button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Health" onclick="showHealth()"><i data-lucide="heart-pulse" class="size-4"></i></button>
					</div>
					<div class="tooltip tooltip-bottom" data-tip="Backups">
						<button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Backups" onclick="showBackups()"><i data-lucide="archive" class="size-4"></i></button>
					</div>
					<details class="dropdown dropdown-end">
						<summary class="btn btn-ghost btn-sm btn-square" aria-label="Config" title="Config"><i data-lucide="settings" class="size-4"></i></summary>
						<ul class="menu menu-sm dropdown-content z-10 mt-1 w-48 rounded-box border border-base-content/10 bg-base-200 p-1 shadow-xl">
							<li><button type="button" hx-post="/config/services" hx-target="#status" onclick="this.closest('details').open = false"><i data-lucide="file-pen" class="size-4"></i>Edit services</button></li>
							<li><button type="button" hx-post="/config/passwords" hx-target="#status" onclick="this.closest('details').open = false"><i data-lucide="key-round" class="size-4"></i>Edit passwords</button></li>
						</ul>
					</details>
					<div class="tooltip tooltip-bottom tooltip-left" data-tip="Light or dark">
						<button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Toggle light or dark theme" onclick="toggleTheme()"><i data-lucide="sun-moon" class="size-4"></i></button>
					</div>
				</nav>
			</header>
			<div class="flex flex-1 min-h-0">
				<!-- The rail picks what the sidebar shows. History has more to show than
				     fits beside the editor, so it opens as a tab. -->
				<nav class="flex w-11 shrink-0 flex-col items-center gap-1 border-r border-base-content/10 bg-base-200 py-2" aria-label="Sidebar">
					@railButton("Explorer", "database", "tree", "", `showSidebar("tree")`)
					@railButton("Saved queries", "bookmark", "queries", "", `showSidebar("queries")`)
					@railButton("History", "history", "", "history", "showHistory()")
				</nav>
				<aside class="flex w-(--sidebar-width) shrink-0 flex-col overflow-hidden bg-base-200" aria-label="Sidebar">
					<section data-sidebar="tree" class="flex min-h-0 flex-1 flex-col">
						<div class="flex h-9 shrink-0 items-center gap-1 pl-3 pr-1">
							<h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-base-content/50">Explorer</h2>
							<button type="button" class="btn btn-square btn-ghost btn-xs" aria-label="Refresh tree" title="Refresh" hx-get={ treeURL(catalog.RootKind, "") } hx-target="#tree" onclick="resetTree()"><i data-lucide="refresh-cw" class="size-3.5"></i></button>
						</div>
						<div class="shrink-0 px-2 pb-2">
							<label class="input input-xs w-full bg-base-100/60 focus-within:outline-1 focus-within:outline-offset-0">
								<i data-lucide="search" class="size-3 opacity-50" aria-hidden="true"></i>
								<input
									id="tree-search"
									type="search"
									name="id"
									placeholder="Search objects…"
									aria-label="Search objects"
									hx-get={ "/tree?kind=" + catalog.SearchKind }
									hx-trigger="input changed delay:200ms, search"
									hx-target="#tree"
									hx-sync="this:replace"
								/>
							</label>
						</div>
						<ul id="tree" class="menu menu-xs w-full flex-1 min-h-0 overflow-auto flex-nowrap pt-0" hx-get={ treeURL(catalog.RootKind, "") } hx-trigger="load, connected from:body">
							<li class="text-base-content/60 px-2">Choose a service to browse it.</li>
						</ul>
					</section>
					<section data-sidebar="queries" class="flex min-h-0 flex-1 flex-col" hidden>
						<div class="flex h-9 shrink-0 items-center gap-1 pl-3 pr-1">
							<h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-base-content/50">Saved queries</h2>
							<button type="button" class="btn btn-square btn-ghost btn-xs" aria-label="Open a query file" title="Open file… (⌘O)" onclick="openQueryFile()"><i data-lucide="folder-open" class="size-3.5"></i></button>
						</div>
						<div id="queries-body" class="flex-1 min-h-0 overflow-auto"></div>
					</section>
				</aside>
				<!-- 1px line with a 7px grip. -->
				<div role="separator" aria-orientation="vertical" aria-label="Resize the sidebar" tabindex="0" data-resize="width" class="relative z-1 -mx-0.75 w-1.75 shrink-0 cursor-col-resize touch-none before:absolute before:inset-y-0 before:left-0.75 before:w-px before:bg-base-content/10 hover:before:bg-primary focus-visible:outline-none focus-visible:before:bg-primary"></div>
				<div class="flex flex-col flex-1 min-w-0">
					<div class="flex h-9 shrink-0 border-b border-base-content/10 bg-base-200">
						<!-- Never scrolls up and down: tabs are exactly its height. -->
						<div id="tabs" role="tablist" aria-label="Query tabs" class="flex min-w-0 overflow-x-auto overflow-y-hidden [scrollbar-width:none]">
							@tabButton("1")
						</div>
						<!-- Server tools are tabs while open, but not query tabs: app.js keeps them apart. -->
						<div role="tablist" aria-label="Server tools" class="flex">
							@toolTab("activity", "Activity", "activity")
							@toolTab("health", "Health", "heart-pulse")
							@toolTab("backups", "Backups", "archive")
							@toolTab("history", "History", "history")
						</div>
						<button type="button" class="btn btn-square btn-ghost btn-xs mx-1 self-center" aria-label="New query tab" title="New tab (⌘T)" hx-post="/tabs" hx-target="#panels" hx-swap="beforeend"><i data-lucide="plus" class="size-3.5"></i></button>
						<button type="button" class="btn btn-square btn-ghost btn-xs ml-auto mr-1 self-center" aria-label="Close all tabs" title="Close all tabs" onclick="closeAllTabs()"><i data-lucide="copy-x" class="size-3.5"></i></button>
					</div>
					<div id="panels" class="flex flex-1 min-h-0">
						@tabPanel("1")
						<section id="activity-panel" data-tool-panel class="flex flex-1 min-w-0 min-h-0 flex-col" hidden>
							<div class="flex h-10 shrink-0 items-center gap-3 border-b border-base-content/10 px-3 text-xs">
								<span class="font-medium text-base-content/70">Connections to this server</span>
								<span class="text-base-content/50">Refreshes every 2 seconds, except while you select text</span>
							</div>
							<!-- The scrolling is out here so that refreshing keeps its place. -->
							<div class="results flex-1 min-h-0 overflow-auto bg-base-100 select-text">
								<div id="activity-body" hx-get="/activity" hx-trigger="every 2s [activityLive()]"></div>
							</div>
						</section>
						<section id="health-panel" data-tool-panel class="flex-1 min-w-0 min-h-0 overflow-auto bg-base-100 p-3 select-text" hidden>
							<div id="health-body"></div>
						</section>
						<section id="backups-panel" data-tool-panel class="flex-1 min-w-0 min-h-0 overflow-auto bg-base-100 p-4 select-text" hidden>
							<!-- A finished job may have made a backup or a sandbox. -->
							<div id="backups-body" class="max-w-5xl" hx-get="/backups" hx-trigger="services-changed[toolOpen('backups')] from:body"></div>
						</section>
						<section id="history-panel" data-tool-panel class="flex flex-1 min-w-0 min-h-0 flex-col bg-base-100" hidden>
							<div id="history-body" class="flex flex-1 min-h-0 flex-col"></div>
						</section>
					</div>
				</div>
			</div>
			<!-- Grows for an error, rather than cutting it off. -->
			<footer class="flex items-center gap-4 min-h-6 shrink-0 px-3 py-0.5 bg-base-200 border-t border-base-content/10 text-[11px] text-base-content/80 select-text">
				<span id="status" class="flex-1 min-w-0">
					if err != nil {
						<span class="text-error whitespace-pre-wrap">{ err.Error() }</span>
					} else if len(services) == 0 {
						<span class="text-base-content/60">No services found in ~/.pg_service.conf</span>
					} else if current != "" {
						@ConnectStatus(current, readOnly, nil)
					}
				</span>
				<span id="notice" class="min-w-0 max-w-[50%] truncate"></span>
				<span id="job" class="min-w-0 max-w-[50%]">
					@JobStatus(j)
				</span>
			</footer>
			<dialog id="confirm" class="modal">
				<form method="dialog" class="modal-box">
					<p id="confirm-text" class="whitespace-pre-wrap"></p>
					<div class="modal-action">
						<button class="btn btn-soft btn-sm" value="no">Cancel</button>
						<button class="btn btn-warning btn-sm" value="yes">Continue</button>
					</div>
				</form>
			</dialog>
			<dialog id="params" class="modal">
				<form method="dialog" class="modal-box">
					<h3 class="text-base font-medium">Parameters</h3>
					<div id="params-fields"></div>
					<p class="text-xs text-base-content/50 mt-3">Values go in as quoted text, which Postgres converts to the type it needs. NULL means null.</p>
					<div class="modal-action">
						<button type="button" class="btn btn-soft btn-sm" onclick="document.querySelector('#params').close()">Cancel</button>
						<button class="btn btn-primary btn-sm" value="yes">Continue</button>
					</div>
				</form>
			</dialog>
			<dialog id="save-query" class="modal">
				<form class="modal-box" hx-post="/queries" hx-target="#save-status">
					<h3 class="text-base font-medium">Save query</h3>
					<label for="save-name" class="block text-xs text-base-content/50 mt-4 mb-1">Name, with folder/ in front to file it in one</label>
					<input id="save-name" name="name" class="input input-sm w-full focus:outline-1 focus:outline-offset-0" required maxlength="200" autocomplete="off" spellcheck="false"/>
					<input id="save-text" type="hidden" name="text"/>
					<div id="save-status" class="mt-2"></div>
					<div class="modal-action">
						<button type="button" class="btn btn-soft btn-sm" onclick="document.querySelector('#save-query').close()">Cancel</button>
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
					</div>
				</form>
			</dialog>
			<dialog id="restore" class="modal">
				<form class="modal-box" hx-post="/backups/restore" hx-target="#job" onsubmit="closeRestore()">
					<h3 class="text-base font-medium">Restore to a new database</h3>
					<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 mt-3 text-xs">
						<dt class="text-base-content/50">Backup</dt>
						<dd id="restore-backup" class="font-mono text-base-content/70 break-all"></dd>
						<dt class="text-base-content/50">Server</dt>
						<dd id="restore-service" class="font-mono text-base-content/70 break-all"></dd>
					</dl>
					<input id="restore-file" type="hidden" name="file"/>
					<label for="restore-name" class="block text-xs text-base-content/50 mt-4 mb-1">New database</label>
					<input id="restore-name" name="database" class="input input-sm w-full font-mono focus:outline-1 focus:outline-offset-0" required maxlength="63" pattern="[A-Za-z_][A-Za-z0-9_]*" title="Letters, numbers and underscores, not starting with a number"/>
					<p class="text-base-content/50 text-xs mt-2">Existing databases aren't touched: a name that's taken just stops the restore.</p>
					<div class="modal-action">
						<button type="button" class="btn btn-soft btn-sm" onclick="document.querySelector('#restore').close()">Cancel</button>
						<button type="submit" class="btn btn-primary btn-sm">Restore</button>
					</div>
				</form>
			</dialog>
			<dialog id="replace" class="modal">
				<form class="modal-box" hx-post="/backups/replace" hx-target="#job" onsubmit="closeReplace()">
					<h3 class="text-base font-medium">Replace a database</h3>
					<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 mt-3 text-xs">
						<dt class="text-base-content/50">Backup</dt>
						<dd id="replace-file" class="font-mono text-base-content/70 break-all"></dd>
						<dt class="text-base-content/50">Replaces</dt>
						<dd id="replace-database" class="font-mono text-base-content/70 break-all"></dd>
					</dl>
					<p id="replace-other" class="text-warning text-xs mt-3" hidden>This backup looks like it's from a different database.</p>
					<p class="text-base-content/50 text-xs mt-3">The backup is restored and checked first, so a bad one changes nothing. Anyone using the database is then disconnected, and it's renamed and kept until you drop it.</p>
					<input id="replace-file-value" type="hidden" name="file"/>
					<label for="replace-confirm" class="block text-xs text-base-content/50 mt-4 mb-1">Type the database's name to confirm</label>
					<input id="replace-confirm" name="confirm" class="input input-sm w-full font-mono focus:outline-1 focus:outline-offset-0" autocomplete="off" spellcheck="false" oninput="checkReplace()"/>
					<div class="modal-action">
						<button type="button" class="btn btn-soft btn-sm" onclick="document.querySelector('#replace').close()">Cancel</button>
						<button id="replace-submit" type="submit" class="btn btn-warning btn-sm" disabled>Replace</button>
					</div>
				</form>
			</dialog>
			<dialog id="cell" class="modal">
				<div class="modal-box max-w-3xl">
					<pre id="cell-text" class="font-mono text-xs whitespace-pre-wrap break-all max-h-[60vh] overflow-auto"></pre>
					<div class="modal-action">
						<button type="button" class="btn btn-soft btn-sm" onclick="copyCell(this, false)">Copy value</button>
						<button type="button" class="btn btn-soft btn-sm" onclick="copyCell(this, true)" title="As JSON, keyed by column name">Copy row as JSON</button>
						<form method="dialog"><button class="btn btn-sm">Close</button></form>
					</div>
				</div>
				<form method="dialog" class="modal-backdrop"><button aria-label="Close">close</button></form>
			</dialog>
		</body>
	</html>
}

// railButton is one of the icons down the left. With a view, it switches the
// sidebar to it; with a tool, it opens that tool's tab. Either way it shows
// whether that's the one showing.
templ railButton(label, icon, view, tool, action string) {
	<div class="tooltip tooltip-right" data-tip={ label }>
		<button
			type="button"
			class="btn btn-ghost btn-sm btn-square relative text-base-content/50 hover:text-base-content aria-pressed:bg-base-300 aria-pressed:text-base-content aria-pressed:before:absolute aria-pressed:before:-left-1.5 aria-pressed:before:inset-y-1.5 aria-pressed:before:w-0.5 aria-pressed:before:rounded-full aria-pressed:before:bg-primary"
			aria-label={ label }
			if view != "" {
				data-sidebar-button={ view }
				aria-pressed={ fmt.Sprint(view == "tree") }
			}
			if tool != "" {
				data-tool-button={ tool }
				aria-pressed="false"
			}
			onclick={ templ.JSUnsafeFuncCall(action) }
		>
			<i data-lucide={ icon } class="size-4.5"></i>
		</button>
	</div>
}

// tabButton is a tab in the strip. app.js marks the open one with tab-active.
// The close button keeps its place and only fades in, so hovering never
// changes a tab's width and moves the ones after it.
templ tabButton(id string) {
	@tabButtonOf(id, "Query "+id, "file-code")
}

// toolTab is a server tool's tab, hidden until the tool is opened.
templ toolTab(id, label, icon string) {
	<span id={ id + "-tab" } class="contents" hidden>
		@tabButtonOf(id, label, icon)
	</span>
}

// tabButtonOf is a tab with any label and icon, for Activity as well as queries.
templ tabButtonOf(id, label, icon string) {
	<span class="group relative flex h-full shrink-0 items-center gap-1.5 border-r border-base-content/10 pl-3 pr-1 text-base-content/60 [&.tab-active]:bg-base-100 [&.tab-active]:text-base-content [&:not(.tab-active)]:hover:bg-base-300/50" data-tab-button={ id }>
		<span aria-hidden="true" class="invisible absolute inset-x-0 top-0 h-0.5 bg-primary group-[.tab-active]:visible"></span>
		<button type="button" role="tab" aria-selected={ fmt.Sprint(id == "1") } class="flex cursor-pointer items-center gap-1.5 whitespace-nowrap focus-visible:underline focus-visible:outline-none" onclick="selectTab(this.parentElement.dataset.tabButton)">
			<i data-lucide={ icon } class="size-3.5 opacity-60"></i>
			{ label }
		</button>
		<button type="button" class="tab-close btn btn-ghost btn-xs btn-square size-5 min-h-0 p-0 opacity-0 group-hover:opacity-100 focus-visible:opacity-100" aria-label={ "Close " + label } onclick="closeTab(this.parentElement.dataset.tabButton)"><i data-lucide="x" class="size-3"></i></button>
	</span>
}

// tabPanel is a tab's toolbar, editor and results. group/tab lets the toolbar
// react while a query runs: htmx marks the Running… indicator htmx-request.
templ tabPanel(id string) {
	<section data-tab={ id } class="group/tab flex flex-col flex-1 min-w-0 min-h-0">
		<!-- Outside the form on purpose: inside it, Stop would inherit
		     hx-sync="this:replace" and abort the very request it is cancelling. -->
		<div class="flex h-10 shrink-0 items-center gap-1 border-b border-base-content/10 px-2">
			<div class="join mr-1">
				<button type="submit" form={ "editor-" + id } class="btn btn-primary btn-sm join-item gap-1.5" title="Run (⌘↵), or just the selection">
					<i data-lucide="play" class="size-3.5 fill-current"></i>
					Run
				</button>
				<button type="button" class="btn btn-primary btn-sm join-item px-1.5" popovertarget={ "run-menu-" + id } style={ templ.SafeCSS("anchor-name:--run-menu-" + id) } aria-label="More ways to run"><i data-lucide="chevron-down" class="size-3.5"></i></button>
			</div>
			<ul popover id={ "run-menu-" + id } style={ templ.SafeCSS("position-anchor:--run-menu-" + id) } class="dropdown menu menu-sm z-10 mt-1 w-48 rounded-box border border-base-content/10 bg-base-200 p-1 shadow-xl">
				<li><button type="submit" form={ "editor-" + id } name="explain" value="1" onclick="this.closest('[popover]').hidePopover()"><i data-lucide="list-tree" class="size-4"></i>Explain</button></li>
				<li><button type="submit" form={ "editor-" + id } name="explain" value="analyze" onclick="this.closest('[popover]').hidePopover()"><i data-lucide="gauge" class="size-4"></i>Explain analyze</button></li>
			</ul>
			<!-- Dim until something runs, then red. -->
			<button type="button" class="btn btn-ghost btn-sm gap-1.5 text-base-content/40 group-has-[.htmx-indicator.htmx-request]/tab:text-error" hx-post="/cancel" hx-vals={ fmt.Sprintf(`{"tab":%q}`, id) } hx-swap="none" title="Stop the running query">
				<i data-lucide="square" class="size-3.5"></i>
				Stop
			</button>
			<div class="mx-1 h-5 w-px bg-base-content/10" aria-hidden="true"></div>
			<div class="tooltip tooltip-bottom" data-tip="Format (⇧⌘F)">
				<button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Format SQL" onclick="formatSQL()"><i data-lucide="align-left" class="size-4"></i></button>
			</div>
			<div class="tooltip tooltip-bottom" data-tip="Save query (⌘S)">
				<button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Save query" onclick="saveQuery()"><i data-lucide="save" class="size-4"></i></button>
			</div>
			<div class="tooltip tooltip-bottom" data-tip="Open file (⌘O)">
				<button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Open a query file" onclick="openQueryFile()"><i data-lucide="folder-open" class="size-4"></i></button>
			</div>
		</div>
		<form
			id={ "editor-" + id }
			class="h-(--editor-height) shrink-0 overflow-hidden bg-base-100 select-text"
			hx-post="/query"
			hx-target={ "#results-" + id }
			hx-sync="this:replace"
			hx-indicator={ "#running-" + id }
		>
			<input type="hidden" name="tab" value={ id }/>
			<textarea name="sql" class="hidden" aria-hidden="true"></textarea>
		</form>
		<div role="separator" aria-orientation="horizontal" aria-label="Resize the editor" tabindex="0" data-resize="height" class="relative z-1 -my-0.75 h-1.75 shrink-0 cursor-row-resize touch-none before:absolute before:inset-x-0 before:top-0.75 before:h-px before:bg-base-content/10 hover:before:bg-primary focus-visible:outline-none focus-visible:before:bg-primary"></div>
		<div class="flex h-8 shrink-0 items-center gap-3 border-b border-base-content/10 bg-base-200 px-3 text-xs">
			<span class="font-medium text-base-content/70">Results</span>
			<span id={ "running-" + id } class="htmx-indicator flex items-center gap-1.5 text-base-content/60">
				<span class="loading loading-spinner loading-xs text-primary"></span>
				Running… <span class="timer font-mono tabular-nums"></span>
			</span>
			<!-- Two steps, as the Save dialog can stay open a while and that isn't
			     running anything: Running… only belongs to the second. -->
			<button id={ "export-" + id } type="button" class="btn btn-ghost btn-xs ml-auto gap-1.5" hx-post="/export/choose" hx-vals={ fmt.Sprintf(`{"tab":%q}`, id) } hx-target="#notice"><i data-lucide="download" class="size-3.5"></i>Export CSV</button>
			<span class="hidden" hx-post="/export" hx-trigger={ "export-ready from:#export-" + id } hx-include={ "#editor-" + id } hx-target="#notice" hx-indicator={ "#running-" + id }></span>
		</div>
		<main id={ "results-" + id } class="results flex-1 min-h-0 overflow-auto bg-base-100 select-text"></main>
	</section>
}

// ExportStatus says where an export went.
templ ExportStatus(path string, rows int64, err error) {
	if err != nil {
		<span class="text-error" title={ err.Error() }>{ err.Error() }</span>
	} else {
		<span class="text-success" title={ path }>Saved { fmt.Sprint(rows) } rows to { path }</span>
	}
}

// NewTab is a new tab's panel, plus its button in the tab strip.
templ NewTab(id string) {
	@tabPanel(id)
	<div hx-swap-oob="beforeend:#tabs">
		@tabButton(id)
	</div>
}

// serviceSelect is swapped as a whole, not by its options: a browser only
// honours a disabled selected option when parsing a new select.
templ serviceSelect(services []string, current string) {
	<select id="service" name="service" class="select select-sm w-auto" hx-get="/services" hx-trigger="focus from:window, services-changed from:body" hx-target="#service-picker">
		<option value="" disabled selected?={ current == "" }>Choose a service…</option>
		for _, name := range services {
			<option value={ name } selected?={ name == current }>{ name }</option>
		}
		if current != "" && !slices.Contains(services, current) {
			<option value={ current } selected>{ current }</option>
		}
	</select>
}

// JobStatus shows the job, polling for as long as it's running.
templ JobStatus(j jobView) {
	if j.Running {
		<span class="flex items-center gap-2 text-xs" hx-get="/job" hx-trigger="every 1s" hx-target="#job">
			<span class="loading loading-spinner loading-xs shrink-0"></span>
			<span class="truncate" title={ j.Line }>{ j.Label }: { j.Line }</span>
			<button type="button" class="btn btn-ghost btn-xs shrink-0" hx-post="/job/cancel" hx-swap="none">Stop</button>
		</span>
	} else if j.Label != "" {
		<span class="flex items-center gap-2 text-xs">
			if j.Err != nil {
				<span class="truncate text-error" title={ j.Err.Error() }>{ j.Label }: { j.Err.Error() }</span>
			} else {
				<span class="truncate text-success" title={ j.Result.Text }>{ j.Result.Text }</span>
				if j.Result.Connect != "" {
					<button type="button" class="btn btn-soft btn-xs shrink-0" hx-post="/connect" hx-vals={ fmt.Sprintf(`{"service":%q}`, j.Result.Connect) } hx-target="#status">Connect</button>
				}
			}
			<button type="button" class="btn btn-ghost btn-xs shrink-0" aria-label="Dismiss" onclick="this.parentElement.remove()">✕</button>
		</span>
	}
}

// BackupsBody is the Backups tab's content.
templ BackupsBody(service, database string, canRestore bool, dir string, files []backupFile, sandboxes []dockerpg.Sandbox, err error) {
	<div class="flex items-center justify-between gap-2">
		<h3 class="font-medium">Backups</h3>
		if service != "" {
			<div class="join">
				<button type="button" class="btn btn-primary btn-sm join-item" hx-post="/backup" hx-target="#job">Back up { service }</button>
				<button type="button" class="btn btn-primary btn-sm join-item px-2" popovertarget="backup-kinds" style="anchor-name:--backup-kinds" aria-label="Other kinds of backup"><i data-lucide="chevron-down" class="size-3.5"></i></button>
			</div>
			<ul popover id="backup-kinds" style="position-anchor:--backup-kinds" class="dropdown dropdown-end menu w-64 rounded-box bg-base-200 shadow-md">
				<li>
					<button type="button" hx-post="/backup" hx-vals='{"schema":"1"}' hx-target="#job" onclick="this.closest('[popover]').hidePopover()">
						<span>
							Schema only
							<span class="block text-xs text-base-content/60">No rows: quick, and enough to compare schemas</span>
						</span>
					</button>
				</li>
			</ul>
		} else {
			<span class="text-base-content/60 text-sm">Connect to a service to back it up.</span>
		}
	</div>
	if err != nil {
		<p class="text-error mt-2">{ err.Error() }</p>
	}
	<button type="button" class="link link-hover text-base-content/60 text-xs mt-1 cursor-pointer" title="Open in Finder. Anything ending .backup here is listed." hx-post="/backups/open" hx-target="#backups-body">{ dir }</button>
	if len(files) == 0 {
		<p class="text-base-content/50 text-sm mt-2">No backups yet.</p>
	} else {
		<div class="mt-2">
			<table class="table table-sm [&_tr>:first-child]:pl-0 [&_tr>:last-child]:pr-0">
				<thead>
					<tr>
						<th>Database</th>
						<th>Version</th>
						<th>Taken</th>
						<th class="text-right">Size</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for i, f := range files {
						<tr title={ f.Name }>
							<td class="font-mono text-xs">
								<div class="flex items-center gap-2 max-w-80">
									<span class="truncate">{ f.Database }</span>
									if f.Schema {
										<span class="badge badge-info badge-xs shrink-0">schema</span>
									}
								</div>
							</td>
							<td class="text-xs">{ f.Version }</td>
							<td class="text-xs whitespace-nowrap">{ f.Taken() }</td>
							<td class="text-xs text-right whitespace-nowrap text-base-content/60">{ f.Size }</td>
							<td class="text-right whitespace-nowrap">
								<button type="button" class="btn btn-soft btn-xs" hx-post="/sandboxes" hx-vals={ fileValues(f.Name) } hx-target="#job">Sandbox</button>
								@backupMenu(fmt.Sprintf("backup-menu-%d", i), f, service, database, canRestore)
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	if len(sandboxes) > 0 {
		<h3 class="font-medium mt-4">Sandboxes</h3>
		<p class="text-base-content/60 text-xs mt-1">Copies of real data, running in Docker until removed. Pick one from the service list to use it.</p>
		<table class="table table-sm mt-2 [&_tr>:first-child]:pl-0 [&_tr>:last-child]:pr-0">
			<thead>
				<tr>
					<th>Sandbox</th>
					<th>From</th>
					<th>Taken</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, sb := range sandboxes {
					{{ from := newBackupFile(sb.Source, 0, time.Time{}) }}
					<tr title={ sb.Source }>
						<td class="font-mono text-xs whitespace-nowrap">{ sb.Name }</td>
						<td class="font-mono text-xs">
							<div class="flex items-center gap-2 max-w-80">
								<span class="truncate">{ from.Database }</span>
								if from.Version != "" {
									<span class="text-base-content/60 shrink-0">{ from.Version }</span>
								}
								if from.Schema {
									<span class="badge badge-info badge-xs shrink-0">schema</span>
								}
							</div>
						</td>
						<td class="text-xs whitespace-nowrap">
							if from.Version != "" {
								{ from.Taken() }
							}
						</td>
						<td class="text-right whitespace-nowrap">
							@sandboxConnect(sb)
							<button type="button" class="btn btn-soft btn-error btn-xs" hx-post={ "/sandboxes/" + sb.Name + "/remove" } hx-target="#backups-body">Remove</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// sandboxConnect shows how to reach a sandbox from other programs, such as
// psql or pgAdmin. pg itself finds them in Docker.
templ sandboxConnect(sb dockerpg.Sandbox) {
	{{ id := "connect-" + sb.Name }}
	<button type="button" class="btn btn-soft btn-xs" popovertarget={ id } style={ templ.SafeCSS("anchor-name:--" + id) }>Connect</button>
	<div popover id={ id } style={ templ.SafeCSS("position-anchor:--" + id) } class="dropdown dropdown-end w-80 rounded-box bg-base-200 shadow-md p-3 text-left">
		<dl class="grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-1 text-xs">
			@connectField("Host", "127.0.0.1")
			@connectField("Port", fmt.Sprint(sb.Port))
			@connectField("Database", sb.Database())
			@connectField("User", "postgres")
			@connectField("Password", sb.Password)
		</dl>
		<button type="button" class="btn btn-soft btn-xs w-full mt-3" data-copy={ sb.URL() } onclick="copyFrom(this)">Copy URL</button>
	</div>
}

templ connectField(name, value string) {
	<dt class="text-base-content/60">{ name }</dt>
	<dd class="font-mono truncate select-all" title={ value }>{ value }</dd>
	<button type="button" class="btn btn-ghost btn-xs" data-copy={ value } onclick="copyFrom(this)" aria-label={ "Copy " + name }>Copy</button>
}

// backupMenu holds a backup's less common actions, including the ones that
// change or delete something, a click away from a slip.
templ backupMenu(id string, f backupFile, service, database string, canRestore bool) {
	<button type="button" class="btn btn-ghost btn-xs" popovertarget={ id } style={ templ.SafeCSS("anchor-name:--" + id) } aria-label={ "More for " + f.Name }>⋯</button>
	<ul popover id={ id } style={ templ.SafeCSS("position-anchor:--" + id) } class="dropdown dropdown-end menu w-36 rounded-box bg-base-200 shadow-md text-left">
		<li><button type="button" hx-post="/backups/verify" hx-vals={ fileValues(f.Name) } hx-target="#job" onclick="this.closest('[popover]').hidePopover()">Verify</button></li>
		if canRestore {
			<li><button type="button" data-file={ f.Name } data-name={ dockerpg.RestoreName(f.Name, time.Now()) } data-service={ service } onclick="this.closest('[popover]').hidePopover(); showRestore(this)">Restore</button></li>
			if database != "" && !f.Schema {
				<li><button type="button" class="text-warning" data-file={ f.Name } data-database={ database } data-other={ fmt.Sprint(!dockerpg.SameDatabase(f.Name, database)) } onclick="this.closest('[popover]').hidePopover(); showReplace(this)">Replace</button></li>
			}
		}
		<li><button type="button" class="text-error" hx-post="/backups/delete" hx-vals={ fileValues(f.Name) } hx-target="#backups-body" data-confirm={ "Delete " + f.Name + " for good? It won't go to the Trash." } onclick="this.closest('[popover]').hidePopover()">Delete</button></li>
	</ul>
}

// QueriesBody is the Saved queries list in the sidebar.
templ QueriesBody(dir string, names []string, err error) {
	if err != nil {
		<p class="text-error text-xs whitespace-pre-wrap px-3 pb-2">{ err.Error() }</p>
	}
	<ul class="menu menu-xs w-full flex-nowrap pt-0">
		if len(names) == 0 {
			<li class="menu-disabled"><span>No saved queries yet.</span></li>
		}
		for _, name := range names {
			<li>
				<button type="button" title={ name } data-name={ name } data-url={ "/queries/" + url.PathEscape(name) } onclick="useQuery(event, this)">
					<i data-lucide="file-code" class="size-3.5 shrink-0 text-primary"></i>
					<span class="truncate">{ name }</span>
				</button>
			</li>
		}
	</ul>
	<button type="button" class="link link-hover block w-full truncate px-3 py-2 text-left text-[11px] text-base-content/50 cursor-pointer" title="Open in Finder. Anything ending .sql here is listed." hx-post="/queries/open" hx-target="#queries-body">{ dir }</button>
}

// SaveStatus says why a query wasn't saved, offering to replace one of the
// same name. The button isn't a submit, so that Enter can't overwrite.
templ SaveStatus(err error) {
	if errors.Is(err, fs.ErrExist) {
		<div class="flex items-center gap-2">
			<span class="text-warning text-xs flex-1">There's already a query with that name.</span>
			<button type="button" class="btn btn-soft btn-warning btn-xs" hx-post="/queries" hx-include="closest form" hx-vals='{"overwrite":"1"}' hx-target="#save-status">Overwrite</button>
		</div>
	} else {
		<p class="text-error text-xs">{ err.Error() }</p>
	}
}

// ActivityBody is the Activity tab's content.
templ ActivityBody(backends []catalog.Backend, canStop bool, err error) {
	if err != nil {
		<p class="text-error whitespace-pre-wrap px-3 py-2">{ err.Error() }</p>
	}
	if len(backends) > 0 {
		<table class="table table-sm table-pin-rows font-mono text-xs">
			<thead>
				<tr>
					<th>PID</th>
					<th>User</th>
					<th>Database</th>
					<th>App</th>
					<th>State</th>
					<th>For</th>
					<th>Blocked by</th>
					<th>Query</th>
					if canStop {
						<th></th>
					}
				</tr>
			</thead>
			<tbody>
				for _, b := range backends {
					<tr data-row class={ templ.KV("text-warning", b.BlockedBy != "") }>
						<td>{ fmt.Sprint(b.PID) }</td>
						<td>{ b.User }</td>
						<td>{ b.Database }</td>
						<td>{ b.App }</td>
						<td>{ b.State }</td>
						<td>{ b.For }</td>
						<td>{ b.BlockedBy }</td>
						<td>{ b.Query }</td>
						if canStop {
							<td class="text-right">
								if b.State == "active" {
									<button type="button" class="btn btn-soft btn-xs" hx-post={ fmt.Sprintf("/activity/%d/cancel", b.PID) } hx-target="#activity-body">Cancel</button>
								}
								<button type="button" class="btn btn-soft btn-error btn-xs ml-1" hx-post={ fmt.Sprintf("/activity/%d/terminate", b.PID) } hx-target="#activity-body" data-confirm={ fmt.Sprintf("End connection %d of %s to %s? Anything it has open is rolled back.", b.PID, b.User, b.Database) }>Terminate</button>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	} else if err == nil {
		<p class="text-base-content/50 px-3 py-2">Nothing else is connected.</p>
	}
}

// HealthBody is the Health tab's content.
templ HealthBody(report catalog.Report, err error) {
	if err != nil {
		<p class="text-error whitespace-pre-wrap">{ err.Error() }</p>
	} else {
		<p class="text-xs text-base-content/60 mb-3">
			Checks marked usage go by statistics counted
			if report.StatsSince != "" {
				since { report.StatsSince },
			} else {
				since the database was made or restored,
			}
			so on a restored copy they say little about the live server.
		</p>
		<div class="tabs tabs-lift tabs-sm">
			for i, check := range report.Checks {
				<label class="tab gap-2">
					<input type="radio" name="health-tab" checked?={ i == 0 }/>
					{ check.Name }
					if check.Err != nil {
						<span class="badge badge-error badge-xs">failed</span>
					} else if len(check.Rows) > 0 {
						<span class="badge badge-warning badge-xs">{ fmt.Sprint(len(check.Rows)) }</span>
					} else {
						<span class="badge badge-success badge-xs">none</span>
					}
				</label>
				<!-- Only the table scrolls, with no padding above it for rows to show
				     through over its pinned header. -->
				<div class="tab-content h-[max(20rem,calc(100vh-12.5rem))] bg-base-100 border-base-300 p-3">
					<div class="flex flex-col h-full">
						<div class="flex items-start gap-2 mb-2 shrink-0">
							<p class="text-sm text-base-content/60">
								if check.Usage {
									<span class="badge badge-ghost badge-sm mr-1">usage</span>
								}
								{ check.Reason }
							</p>
							<button type="button" class="btn btn-ghost btn-xs ml-auto shrink-0" data-sql={ check.SQL } onclick="useSQL(event, this)">Open as query</button>
						</div>
						if check.Err != nil {
							<p class="text-error text-sm whitespace-pre-wrap">{ check.Err.Error() }</p>
						} else if len(check.Rows) > 0 {
							<div class="results flex-1 min-h-0 overflow-auto">
								<table class="table table-sm table-pin-rows font-mono text-xs">
									<thead>
										<tr>
											for _, c := range check.Columns {
												<th>{ c }</th>
											}
										</tr>
									</thead>
									<tbody>
										for _, row := range check.Rows {
											<tr>
												for _, v := range row {
													<td title={ v }>{ v }</td>
												}
											</tr>
										}
									</tbody>
								</table>
							</div>
						} else {
							<p class="text-sm text-success">Nothing found.</p>
						}
					</div>
				</div>
			}
		</div>
	}
}

// ConnectFailed is the error, plus the dropdown to swap back in.
templ ConnectFailed(services []string, current string, err error) {
	@ConnectStatus("", false, err)
	<div hx-swap-oob="innerHTML:#service-picker">
		@serviceSelect(services, current)
	</div>
}

templ ConnectStatus(service string, readOnly bool, err error) {
	if err != nil {
		<span class="text-error whitespace-pre-wrap">{ err.Error() }</span>
		if conn.PasswordRejected(err) {
			<span class="text-base-content/60 ml-1">Passwords go in ~/.pgpass, as host:port:database:user:password. Use Config to edit it.</span>
		}
	} else {
		<span class="inline-flex items-center gap-1.5"><span class="status status-success" aria-hidden="true"></span>Connected to { service }</span>
		if readOnly {
			<span class="badge badge-warning badge-xs ml-1" data-read-only>read-only</span>
		}
		if dockerpg.IsSandbox(service) {
			<span class="badge badge-info badge-xs ml-1">sandbox</span>
		}
		if path := conn.ExposedPassFile(); path != "" {
			<span class="badge badge-error badge-xs ml-1" title="Anyone with access to this computer can read your passwords">Password file is readable by others: chmod 600 { path }</span>
		}
	}
}

// TreeNodes is one level of the tree. A node's children load the first time
// it is opened, or the next time after a failure.
templ TreeNodes(nodes []catalog.Node, err error) {
	if err != nil {
		<li class="tree-error text-error whitespace-pre-wrap px-2">{ err.Error() }</li>
	} else if len(nodes) == 0 {
		<li class="text-base-content/50 px-2">None</li>
	}
	for _, n := range nodes {
		<li>
			if n.Kind != "" {
				<details hx-get={ treeURL(n.Kind, n.ID) } hx-trigger="toggle[target.open && target.querySelectorAll(':scope > ul > li > .loading, :scope > ul > .tree-error').length > 0]" hx-target="find ul">
					<summary>
						@treeLabel(n)
					</summary>
					<ul>
						<li><span class="loading loading-spinner loading-xs"></span></li>
					</ul>
				</details>
			} else {
				<div>
					@treeLabel(n)
				</div>
			}
		</li>
	}
}

templ treeLabel(n catalog.Node) {
	<span class="group flex items-baseline gap-2 min-w-0 w-full">
		if icon := nodeIcon(n); icon != "" {
			<i data-lucide={ icon } class={ "size-3.5 shrink-0 self-center", nodeIconColour(icon) } aria-hidden="true"></i>
		}
		if n.SQL != "" {
			<button type="button" class="cursor-pointer min-w-0 truncate hover:underline" title={ n.Label } data-sql={ n.SQL } onclick="useSQL(event, this)">{ n.Label }</button>
		} else if n.Def != "" {
			<button type="button" class="cursor-pointer shrink-0 max-w-full truncate hover:underline" title={ n.Label } data-url={ definitionURL(n) } onclick="useDefinition(event, this)">{ n.Label }</button>
		} else {
			<span class="shrink-0 max-w-full truncate" title={ n.Label }>{ n.Label }</span>
		}
		if n.Detail != "" {
			<span class="truncate shrink-1000 text-base-content/50" title={ n.Detail }>{ n.Detail }</span>
		}
		if n.SQL != "" && n.Def != "" {
			<button type="button" class="cursor-pointer shrink-0 ml-auto text-base-content/60 opacity-0 hover:underline group-hover:opacity-100 focus:opacity-100" aria-label={ "Show the definition of " + n.Label } data-url={ definitionURL(n) } onclick="useDefinition(event, this)">DDL</button>
		}
	</span>
}

// fileValues is the hx-vals naming a backup.
func fileValues(name string) string {
	return fmt.Sprintf(`{"file":%q}`, name)
}

// nodeIcon is the Lucide icon for a tree node: by what it opens to, or for a
// leaf, by what its definition is. Columns and the like have none.
func nodeIcon(n catalog.Node) string {
	switch n.Kind {
	case "schema":
		return "layers"
	case "roles", "memberof", "members":
		return "users"
	case "role":
		return "user"
	case "table", "partitioned":
		return "table-2"
	case "view":
		return "eye"
	case "matview":
		return "box"
	case "columns":
		return "columns-3"
	case "indexes":
		return "list-tree"
	case "constraints":
		return "shield-check"
	case "triggers":
		return "zap"
	case "grants":
		return "key-round"
	case "":
		switch n.Def {
		case "function":
			return "square-function"
		case "sequence":
			return "hash"
		case "type", "domain":
			return "shapes"
		case "collation":
			return "languages"
		case "role":
			return "user"
		}
		return ""
	}
	return "folder"
}

// nodeIconColour picks out the objects you query, over the folders around them.
func nodeIconColour(icon string) string {
	switch icon {
	case "table-2":
		return "text-info"
	case "eye", "box":
		return "text-secondary"
	case "square-function":
		return "text-accent"
	}
	return "text-base-content/50"
}

func treeURL(kind, id string) string {
	return "/tree?" + url.Values{"kind": {kind}, "id": {id}}.Encode()
}

func definitionURL(n catalog.Node) string {
	return "/definition?" + url.Values{"def": {n.Def}, "id": {n.ID}}.Encode()
}

templ Results(p session.Page, tab string) {
	if p.Plan != "" {
		@planView(p)
	} else if len(p.Columns) == 0 {
		@summary(p)
	} else if isPlan(p) {
		<pre class="p-2 font-mono text-xs">
			for _, row := range p.Rows {
				<div class={ templ.KV("text-warning", strings.Contains(row[0].Text, "Seq Scan")) }>{ row[0].Text }</div>
			}
		</pre>
		@summary(p)
	} else {
		<table class="table table-xs table-pin-rows font-mono text-[12px] [&_th]:bg-base-200 [&_th]:font-sans [&_th]:text-[11px] [&_th]:font-semibold [&_th]:text-base-content [&_:is(th,td)]:border-r [&_:is(th,td)]:border-base-content/5">
			<thead>
				<tr>
					for _, c := range p.Columns {
						<th>{ c }</th>
					}
				</tr>
			</thead>
			<tbody>
				@MoreRows(p, tab)
			</tbody>
		</table>
	}
}

// planView shows what Explain returned as a tree, or as it came if that fails.
templ planView(p session.Page) {
	if tree, err := parsePlan(p.Plan); err != nil {
		<pre class="p-2 font-mono text-xs">{ p.Plan }</pre>
	} else {
		<div class="p-2 text-sm">
			<ul>
				@planStep(tree.Root)
			</ul>
		</div>
		<div class="flex items-center gap-3 pr-2">
			<div class="flex-1 min-w-0">
				@summary(p)
			</div>
			if tree.Timing != "" {
				<span class="text-xs text-base-content/60">{ tree.Timing }</span>
			}
			<button type="button" class="btn btn-ghost btn-xs" data-plan={ p.Plan } onclick="copyPlan(this)">Copy JSON</button>
		</div>
	}
}

templ planStep(n *planNode) {
	<li>
		<details>
			<summary class="flex flex-wrap items-center gap-x-3 gap-y-0.5 rounded px-1 py-0.5 cursor-pointer hover:bg-base-200">
				<span class="w-20 h-2 shrink-0 overflow-hidden rounded-full bg-base-300" title={ fmt.Sprintf("%.0f%% of the plan", n.Share*100) }>
					<span class={ "block h-full", templ.KV("bg-warning", n.Slowest), templ.KV("bg-primary", !n.Slowest) } style={ fmt.Sprintf("width:%.1f%%", n.Share*100) }></span>
				</span>
				<span class={ "font-medium", templ.KV("text-warning", n.SeqScan) }>{ n.Type }</span>
				if n.Target != "" {
					<span class="font-mono text-xs">{ n.Target }</span>
				}
				<span class="text-xs text-base-content/60">{ n.Stats }</span>
				if n.Estimate != "" {
					<span class="badge badge-warning badge-xs">{ n.Estimate }</span>
				}
			</summary>
			<dl class="grid grid-cols-[auto_1fr] gap-x-3 ml-24 my-1 text-xs">
				for _, d := range n.Details {
					<dt class="text-base-content/60">{ d.Name }</dt>
					<dd class="font-mono whitespace-pre-wrap wrap-break-word min-w-0">{ d.Value }</dd>
				}
			</dl>
		</details>
		if len(n.Children) > 0 {
			<ul class="ml-3 pl-3 border-l border-base-300">
				for _, child := range n.Children {
					@planStep(child)
				}
			</ul>
		}
	</li>
}

// MoreRows is a page of rows followed by either a sentinel row that loads
// the next page when it scrolls into view, or a footer once the query is done.
templ MoreRows(p session.Page, tab string) {
	for _, row := range p.Rows {
		<tr data-row>
			for _, v := range row {
				if v.Null {
					<td data-null class="italic text-base-content/50">NULL</td>
				} else {
					<td>{ v.Text }</td>
				}
			}
		</tr>
	}
	if p.Done {
		<tr>
			<td colspan={ fmt.Sprint(p.NumCols) }>
				@summary(p)
			</td>
		</tr>
	} else if p.Ended {
		<!-- Comes in after the table, leaving this row as the table's summary. -->
		<tr
			hx-get={ fmt.Sprintf("/query/%d/more?tab=%s&next=1", p.QueryID, url.QueryEscape(tab)) }
			hx-trigger="intersect once"
			hx-target="closest table"
			hx-swap="afterend"
		>
			<td colspan={ fmt.Sprint(p.NumCols) }>
				@summary(p)
			</td>
		</tr>
	} else {
		<tr
			hx-get={ fmt.Sprintf("/query/%d/more?tab=%s", p.QueryID, url.QueryEscape(tab)) }
			hx-trigger="intersect once"
			hx-swap="outerHTML"
		>
			<td colspan={ fmt.Sprint(p.NumCols) } class="text-base-content/60">{ fmt.Sprint(p.Total) } rows so far, loading more…</td>
		</tr>
	}
}

templ summary(p session.Page) {
	<div class="p-2">
		if p.Err != nil {
			<span class="text-error whitespace-pre-wrap">{ p.Err.Error() }</span>
		} else {
			<span class="text-success">{ summaryText(p) }</span>
		}
	</div>
}

// isPlan reports whether p is an EXPLAIN typed into the editor, which reads
// better as text than as a one-column grid.
func isPlan(p session.Page) bool {
	return p.Done && len(p.Columns) == 1 && p.Columns[0] == "QUERY PLAN"
}

func summaryText(p session.Page) string {
	parts := make([]string, 0, len(p.Tags)+2)
	if p.NumCols > 0 {
		parts = append(parts, fmt.Sprintf("%d rows", p.Total))
	}
	parts = append(parts, p.Tags...)
	// Finer under a second, where a nearby server's round trip is well under 1ms.
	precision := time.Millisecond
	if p.Elapsed < time.Second {
		precision = 10 * time.Microsecond
	}
	parts = append(parts, p.Elapsed.Round(precision).String())
	return strings.Join(parts, " · ")
}

// HistoryBody is the History tab: filters over the entries on the left, the
// chosen entry beside them. Only the list reloads as the filters change, so
// the search box keeps its focus.
templ HistoryBody(services []string, entries []history.Entry, err error) {
	if err != nil {
		<p class="text-error whitespace-pre-wrap px-3 py-2">{ err.Error() }</p>
	} else {
		<div class="flex flex-1 min-h-0">
			<form class="flex flex-1 min-w-0 flex-col" hx-get="/history/list" hx-target="#history-list" hx-trigger="input delay:200ms, history-changed from:body" onsubmit="event.preventDefault()">
				<input type="hidden" name="sort" value=""/>
				<input type="hidden" name="selected" value=""/>
				<div class="flex h-10 shrink-0 items-center gap-2 border-b border-base-content/10 px-2">
					<label class="input input-sm w-full max-w-sm focus-within:outline-1 focus-within:outline-offset-0">
						<i data-lucide="search" class="size-3.5 opacity-50"></i>
						<input id="history-search" name="q" type="search" placeholder="Search SQL and notes…" aria-label="Search history"/>
					</label>
					<select name="service" class="select select-sm w-44" aria-label="Service">
						<option value="">All services</option>
						for _, service := range services {
							<option>{ service }</option>
						}
					</select>
					<label class="label gap-1.5 shrink-0 text-xs text-base-content"><input type="checkbox" name="starred" class="checkbox checkbox-xs"/> Starred only</label>
					<details class="dropdown dropdown-end ml-auto">
						<summary class="btn btn-ghost btn-sm gap-1.5"><i data-lucide="trash-2" class="size-3.5"></i>Clear</summary>
						<ul class="menu menu-sm dropdown-content z-10 mt-1 w-48 rounded-box border border-base-content/10 bg-base-200 p-1 shadow-xl">
							<li><button type="button" hx-post="/history/clear" hx-vals={ `{"days":"30"}` } hx-swap="none" data-confirm="Clear runs older than 30 days? Starred queries stay." onclick="this.closest('details').open = false">Older than 30 days</button></li>
							<li><button type="button" hx-post="/history/clear" hx-vals={ `{"days":"90"}` } hx-swap="none" data-confirm="Clear runs older than 90 days? Starred queries stay." onclick="this.closest('details').open = false">Older than 90 days</button></li>
							<li><button type="button" class="text-error" hx-post="/history/clear" hx-vals={ `{"days":"all"}` } hx-swap="none" data-confirm="Clear all history? Starred queries stay, without their runs." onclick="this.closest('details').open = false">Everything</button></li>
						</ul>
					</details>
				</div>
				<div id="history-list" class="results flex-1 min-h-0 overflow-auto select-text">
					@HistoryList(entries, "", 0, nil)
				</div>
			</form>
			<!-- Outside the form, so typing a note doesn't reload the list. -->
			<div id="history-detail" class="flex w-[min(36rem,40%)] shrink-0 flex-col min-h-0 border-l border-base-content/10 bg-base-200 select-text">
				<p class="px-3 py-2 text-xs text-base-content/50">Choose a query to see its runs.</p>
			</div>
		</div>
	}
}

// HistoryList is the entries matching the filters, sorted by sort, with the
// one whose detail is showing marked.
templ HistoryList(entries []history.Entry, sort string, selected int64, err error) {
	if err != nil {
		<p class="text-error text-xs whitespace-pre-wrap px-3 py-2">{ err.Error() }</p>
	} else if len(entries) == 0 {
		<p class="text-xs text-base-content/50 px-3 py-2">Nothing found.</p>
	} else {
		<table class="table table-xs table-pin-rows text-xs [&_th]:bg-base-200 [&_th]:text-[11px] [&_th]:font-semibold [&_th]:text-base-content">
			<thead>
				<tr>
					<th class="w-8"><span class="sr-only">Starred</span></th>
					<th>@sortButton("SQL", "sql", sort)</th>
					<th>@sortButton("Last run", "", sort)</th>
					<th>@sortButton("Runs", "runs", sort)</th>
					<th>Services</th>
				</tr>
			</thead>
			<tbody>
				for _, e := range entries {
					<!-- The SQL's button stretches over the row, so a click anywhere opens it,
					     and so does Tab then Enter. The star sits above it. -->
					<tr
						class="relative hover:bg-base-200/60 aria-current:bg-primary/10 aria-current:shadow-[inset_2px_0_0_var(--color-primary)]"
						if e.ID == selected {
							aria-current="true"
						}
					>
						<td>@starButton(e, "btn-xs relative z-10")</td>
						<td class="max-w-[40vw]">
							<button
								type="button"
								class="block w-full truncate text-left font-mono cursor-pointer after:absolute after:inset-0 focus-visible:outline-none"
								title={ e.SQL }
								data-id={ fmt.Sprint(e.ID) }
								hx-get={ fmt.Sprintf("/history/%d", e.ID) }
								hx-target="#history-detail"
								onclick="chooseHistory(this)"
							>{ e.SQL }</button>
						</td>
						<td class="whitespace-nowrap">{ ranAt(e.LastRun) }</td>
						<td class="tabular-nums">{ fmt.Sprint(e.Runs) }</td>
						<td class="max-w-40 truncate" title={ e.Services }>{ e.Services }</td>
					</tr>
				}
			</tbody>
		</table>
		if len(entries) == history.ShowMost {
			<p class="text-xs text-base-content/50 px-3 py-2">Showing the first { fmt.Sprint(history.ShowMost) }: search to narrow them down.</p>
		}
	}
}

// sortButton heads a column that the list can be sorted by.
templ sortButton(label, by, sort string) {
	<button type="button" class={ "inline-flex items-center gap-0.5 cursor-pointer hover:underline", templ.KV("text-primary", by == sort) } onclick={ templ.JSUnsafeFuncCall(fmt.Sprintf("sortHistory(this, %q)", by)) }>
		{ label }
		if by == sort {
			<i data-lucide="chevron-down" class="size-3"></i>
		}
	</button>
}

// starButton stars or unstars e.
templ starButton(e history.Entry, size string) {
	<button
		type="button"
		class={ "btn btn-ghost btn-square", size }
		hx-post={ fmt.Sprintf("/history/%d/star", e.ID) }
		if e.Starred {
			hx-vals={ `{"starred":"0"}` }
			aria-label="Unstar"
			title="Unstar"
		} else {
			hx-vals={ `{"starred":"1"}` }
			aria-label="Star"
			title="Star, to keep it and show it first"
		}
		hx-swap="none"
	>
		if e.Starred {
			<i data-lucide="star" class="size-3.5 fill-current text-warning"></i>
		} else {
			<i data-lucide="star" class="size-3.5 opacity-40"></i>
		}
	</button>
}

// HistoryDetail is one entry, with its note and runs. It reloads itself when
// anything in the history changes, such as its star.
templ HistoryDetail(e history.Entry, runs []history.Run, err error) {
	<div class="flex flex-col flex-1 min-h-0" hx-get={ fmt.Sprintf("/history/%d", e.ID) } hx-trigger="history-changed from:body" hx-swap="outerHTML">
		if err != nil {
			<p class="px-3 py-2 text-xs text-base-content/50">{ err.Error() }</p>
		} else {
			<div class="flex h-10 shrink-0 items-center gap-1 border-b border-base-content/10 px-2">
				@starButton(e, "btn-sm")
				<button type="button" class="btn btn-primary btn-sm gap-1.5" data-sql={ e.SQL } onclick="useSQL(event, this)"><i data-lucide="file-input" class="size-3.5"></i>Open</button>
				<button type="button" class="btn btn-ghost btn-sm gap-1.5" data-copy={ e.SQL } onclick="copyFrom(this)"><i data-lucide="copy" class="size-3.5"></i>Copy</button>
				<button type="button" class="btn btn-ghost btn-sm gap-1.5 text-error ml-auto" hx-delete={ fmt.Sprintf("/history/%d", e.ID) } hx-swap="none" data-confirm={ fmt.Sprintf("Remove this query and its %d runs from history?", e.Runs) }><i data-lucide="trash-2" class="size-3.5"></i>Remove</button>
			</div>
			<!-- The SQL takes whatever height the runs leave, and scrolls in it. -->
			<div class="flex flex-1 min-h-0 flex-col p-3">
				<pre class="flex-1 min-h-24 font-mono text-xs whitespace-pre-wrap bg-base-100 border border-base-content/10 rounded-box p-2 overflow-auto">{ e.SQL }</pre>
				<textarea name="note" class="textarea textarea-sm w-full mt-2 shrink-0 transition-colors duration-500" rows="2" placeholder="Note, saved when you leave the box" aria-label="Note" hx-post={ fmt.Sprintf("/history/%d/note", e.ID) } hx-trigger="change" hx-swap="none">{ e.Note }</textarea>
				<h3 class="mt-3 mb-1 shrink-0 text-[11px] font-semibold uppercase tracking-wider text-base-content/50">Recent runs</h3>
				<table class="table table-xs text-xs shrink-0">
					<thead>
						<tr><th>Ran</th><th>Service</th><th>Database</th></tr>
					</thead>
					<tbody>
						for _, run := range runs {
							<tr>
								<td class="whitespace-nowrap">{ ranAt(run.At) }</td>
								<td>{ run.Service }</td>
								<td>{ run.Database }</td>
							</tr>
						}
					</tbody>
				</table>
				if len(runs) == 0 {
					<p class="text-xs text-base-content/50 py-1">Its runs have been cleared, but it's starred, so it stays.</p>
				} else if earlier := e.Runs - len(runs); earlier == 1 {
					<p class="text-xs text-base-content/50 py-1 shrink-0">and 1 earlier run</p>
				} else if earlier > 1 {
					<p class="text-xs text-base-content/50 py-1 shrink-0">and { fmt.Sprint(earlier) } earlier runs</p>
				}
			</div>
		}
	</div>
}
